       }
     }
 
+    Function("takeLeveReviewRequest") { () -> Bool in
+      let pending = UserDefaults.standard.bool(forKey: "LeveReviewWorkout")
+      UserDefaults.standard.removeObject(forKey: "LeveReviewWorkout")
+      return pending
+    }
+    AsyncFunction("pendingLeveActivityTaps") { () async throws -> [[String: Any]] in
+      try await LeveActivityInbox.shared.pending().map { $0.event }
+    }
+    AsyncFunction("finishLeveActivityTap") { (id: String, applied: Bool, reviewed: Bool) async throws in
+      try await LeveActivityInbox.shared.finish(id: id, applied: applied, reviewed: reviewed)
+    }
+
