diff --git a/ios/Widgets/LeveActivityTap.swift b/ios/Widgets/LeveActivityTap.swift
new file mode 100644
index 0000000000000000000000000000000000000000..32d298852aa36fd1f1e3a681bf0ffe128a8d71ed
--- /dev/null
+++ b/ios/Widgets/LeveActivityTap.swift
@@ -0,0 +1,110 @@
+import Foundation
+
+// LiveActivityIntent runs in the containing app process. Keep only the opaque button
+// ticket in its private Application Support directory, before notifying JavaScript.
+struct LeveActivityTap: Codable {
+  let id: UUID
+  let source: String
+  let target: String
+  let timestamp: Double
+
+  // Review status belongs to the filename. The v1 payload contains only these four fields.
+  private enum CodingKeys: String, CodingKey { case id, source, target, timestamp }
+  var reviewOnly = false
+
+  var event: [String: Any] {
+    ["id": id.uuidString, "source": source, "target": target, "timestamp": timestamp, "reviewOnly": reviewOnly]
+  }
+}
+
+actor LeveActivityInbox {
+  static let shared = LeveActivityInbox()
+  private let root: URL?
+  init(root: URL? = nil) { self.root = root }
+
+  private var consumerStarted = false
+  private var waiting = Set<UUID>()
+  private var results: [UUID: Bool] = [:]
+
+  private func directory() throws -> URL {
+    let manager = FileManager.default
+    let support = try root ?? manager.url(for: .applicationSupportDirectory, in: .userDomainMask,
+                              appropriateFor: nil, create: true)
+    var dir = support.appendingPathComponent("LeveActivityTaps-v1")
+    try manager.createDirectory(at: dir, withIntermediateDirectories: true)
+    var values = URLResourceValues()
+    values.isExcludedFromBackup = true
+    try dir.setResourceValues(values)
+    return dir
+  }
+
+  func enqueue(source: String, target: String) throws -> LeveActivityTap {
+    let tap = LeveActivityTap(id: UUID(), source: source, target: target,
+                              timestamp: Date().timeIntervalSince1970 * 1000)
+    let url = try directory().appendingPathComponent(tap.id.uuidString)
+    try JSONEncoder().encode(tap).write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    waiting.insert(tap.id)
+    return tap
+  }
+
+  func pending() throws -> [LeveActivityTap] {
+    consumerStarted = true
+    let files = try FileManager.default.contentsOfDirectory(at: directory(), includingPropertiesForKeys: nil,
+                                                            options: [.skipsHiddenFiles])
+    return files.compactMap { url -> LeveActivityTap? in
+      let review = url.pathExtension == "review"
+      let name = review ? url.deletingPathExtension() : url
+      guard let id = UUID(uuidString: name.lastPathComponent) else { return nil }
+      guard var tap = try? JSONDecoder().decode(LeveActivityTap.self, from: Data(contentsOf: url)), tap.id == id else {
+        // Keep the file available for acknowledgement without trusting its contents.
+        return LeveActivityTap(id: id, source: "", target: "", timestamp: 0, reviewOnly: true)
+      }
+      tap.reviewOnly = review
+      return tap
+    }.sorted { $0.timestamp < $1.timestamp }
+  }
+
+  func finish(id: String, applied: Bool, reviewed: Bool) throws {
+    guard let uuid = UUID(uuidString: id) else { return }
+    let url = try directory().appendingPathComponent(uuid.uuidString)
+    let manager = FileManager.default
+    let marker = url.appendingPathExtension("review")
+    if applied || reviewed {
+      for item in [url, marker] where manager.fileExists(atPath: item.path) {
+        try manager.removeItem(at: item)
+      }
+    } else if manager.fileExists(atPath: url.path) {
+      // The rejection must survive the intent process and must never be retried as a write.
+      try manager.moveItem(at: url, to: marker)
+    }
+    if waiting.contains(uuid) { results[uuid] = applied }
+  }
+
+  func result(for id: UUID) async throws -> Bool {
+    defer {
+      waiting.remove(id)
+      results.removeValue(forKey: id)
+    }
+    // A scene-less cold launch has no React consumer. Open the app immediately and
+    // let its first mounted host validate the same ticket after unlocking.
+    guard consumerStarted else { return false }
+    for _ in 0..<20 {
+      if let applied = results[id] { return applied }
+      try await Task.sleep(nanoseconds: 100_000_000)
+    }
+    if let applied = results[id] { return applied }
+    return false
+  }
+
+  // False requests foreground delivery. Keep the ticket until the app consumes it.
+  func deliver(source: String, target: String, notify: (LeveActivityTap) -> Void) async -> Bool {
+    do {
+      let tap = try enqueue(source: source, target: target)
+      notify(tap)
+      return try await result(for: tap.id)
+    } catch {
+      UserDefaults.standard.set(true, forKey: "LeveReviewWorkout")
+      return false
+    }
+  }
+}
