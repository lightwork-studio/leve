diff --git a/ios/Widgets/LeveActivityTap.swift b/ios/Widgets/LeveActivityTap.swift
new file mode 100644
index 0000000..d66b29a
--- /dev/null
+++ b/ios/Widgets/LeveActivityTap.swift
@@ -0,0 +1,176 @@
+import Foundation
+
+// LiveActivityIntent runs in the containing app process. Keep only the opaque button
+// ticket in its private Application Support directory, before notifying JavaScript.
+struct LeveActivityTap: Codable {
+  let id: UUID
+  let source: String
+  let target: String
+  let timestamp: Double
+
+  // Review status belongs to the filename. The v1 payload contains only these four fields.
+  private enum CodingKeys: String, CodingKey { case id, source, target, timestamp }
+  var reviewOnly = false
+
+  var event: [String: Any] {
+    ["id": id.uuidString, "source": source, "target": target, "timestamp": timestamp, "reviewOnly": reviewOnly]
+  }
+}
+
+actor LeveActivityInbox {
+  static let shared = LeveActivityInbox()
+  private let root: URL?
+  init(root: URL? = nil) { self.root = root }
+
+  private var consumerStarted = false
+  private var waiting = Set<UUID>()
+  private var results: [UUID: Bool] = [:]
+
+  private func directory() throws -> URL {
+    let manager = FileManager.default
+    let support = try root ?? manager.url(for: .applicationSupportDirectory, in: .userDomainMask,
+                              appropriateFor: nil, create: true)
+    var dir = support.appendingPathComponent("LeveActivityTaps-v1")
+    try manager.createDirectory(at: dir, withIntermediateDirectories: true)
+    var values = URLResourceValues()
+    values.isExcludedFromBackup = true
+    try dir.setResourceValues(values)
+    return dir
+  }
+
+  func enqueue(source: String, target: String) throws -> LeveActivityTap {
+    let tap = LeveActivityTap(id: UUID(), source: source, target: target,
+                              timestamp: Date().timeIntervalSince1970 * 1000)
+    let url = try directory().appendingPathComponent(tap.id.uuidString)
+    try JSONEncoder().encode(tap).write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    waiting.insert(tap.id)
+    return tap
+  }
+
+  func pending() throws -> [LeveActivityTap] {
+    consumerStarted = true
+    let files = try FileManager.default.contentsOfDirectory(at: directory(), includingPropertiesForKeys: nil,
+                                                            options: [.skipsHiddenFiles])
+    return files.compactMap { url -> LeveActivityTap? in
+      let review = url.pathExtension == "review"
+      let name = review ? url.deletingPathExtension() : url
+      guard let id = UUID(uuidString: name.lastPathComponent) else { return nil }
+      guard var tap = try? JSONDecoder().decode(LeveActivityTap.self, from: Data(contentsOf: url)), tap.id == id else {
+        // Keep the file available for acknowledgement without trusting its contents.
+        return LeveActivityTap(id: id, source: "", target: "", timestamp: 0, reviewOnly: true)
+      }
+      tap.reviewOnly = review
+      return tap
+    }.sorted { $0.timestamp < $1.timestamp }
+  }
+
+  func finish(id: String, applied: Bool, reviewed: Bool) throws {
+    guard let uuid = UUID(uuidString: id) else { return }
+    let url = try directory().appendingPathComponent(uuid.uuidString)
+    let manager = FileManager.default
+    let marker = url.appendingPathExtension("review")
+    if applied || reviewed {
+      for item in [url, marker] where manager.fileExists(atPath: item.path) {
+        try manager.removeItem(at: item)
+      }
+    } else if manager.fileExists(atPath: url.path) {
+      // The rejection must survive the intent process and must never be retried as a write.
+      try manager.moveItem(at: url, to: marker)
+    }
+    if waiting.contains(uuid) { results[uuid] = applied }
+  }
+
+  func needsConsumer() -> Bool { !consumerStarted }
+
+  func result(for id: UUID, waitForStartup: Bool = false) async throws -> Bool {
+    defer {
+      waiting.remove(id)
+      results.removeValue(forKey: id)
+    }
+    // Give a scene-less runtime time to load the bundle and open the store. A timeout
+    // keeps the opaque ticket available for the foreground handoff.
+    guard consumerStarted || waitForStartup else { return false }
+    let attempts = waitForStartup ? 80 : 20
+    for _ in 0..<attempts {
+      if let applied = results[id] { return applied }
+      try await Task.sleep(nanoseconds: 100_000_000)
+    }
+    if let applied = results[id] { return applied }
+    return false
+  }
+
+  // False requests foreground delivery. Keep the ticket until the app consumes it.
+  func deliver(
+    source: String, target: String, waitForStartup: Bool = false, notify: (LeveActivityTap) async -> Void
+  ) async -> Bool {
+    do {
+      let tap = try enqueue(source: source, target: target)
+      await notify(tap)
+      return try await result(for: tap.id, waitForStartup: waitForStartup)
+    } catch {
+      UserDefaults.standard.set(true, forKey: "LeveReviewWorkout")
+      return false
+    }
+  }
+}
+
+enum LeveRestAction: String {
+  case less, more, skip
+
+  init?(target: String) {
+    let parts = target.split(separator: ":", omittingEmptySubsequences: false)
+    guard parts.count == 2, parts[0].hasPrefix("leveRest.") || parts[0].hasPrefix("leve1.") else {
+      return nil
+    }
+    self.init(rawValue: String(parts[1]))
+  }
+
+  func change(target: String, props: [String: Any], now: Double) -> LeveRestChange? {
+    guard let key = props["restKey"] as? String,
+          target == "leveRest.\(key):\(rawValue)" ||
+            (props["token"] as? String).map({ target == "\($0):\(rawValue)" }) == true,
+          let start = props["restStart"] as? Double,
+          let end = props["restEnd"] as? Double,
+          start < end, end > now else { return nil }
+    switch self {
+    case .less:
+      // Advance the displayed progress by 15 seconds at the existing pace.
+      if end - 15_000 > now {
+        return LeveRestChange(key: key, start: start - 15_000, end: end - 15_000)
+      }
+      return LeveRestChange(key: key, start: 0, end: 0)
+    case .more:
+      return LeveRestChange(key: key, start: start, end: end + 15_000)
+    case .skip:
+      return LeveRestChange(key: key, start: 0, end: 0)
+    }
+  }
+}
+
+struct LeveRestChange: Sendable, Equatable {
+  let key: String
+  let start: Double
+  let end: Double
+
+  var staleDate: Date? {
+    end > 0 ? Date(timeIntervalSince1970: end / 1000) : nil
+  }
+
+  func apply(to props: inout [String: Any]) {
+    props["restStart"] = start
+    props["restEnd"] = end
+  }
+}
+
+
+// The widget rewrites the deadline segment of a Log ticket after native rest edits.
+func canLogLeveActivity(target: String, props: [String: Any], now: Double) -> Bool {
+  guard props["canLog"] as? Bool == true,
+        let deadline = props["restEnd"] as? Double, deadline <= now,
+        let shown = props["token"] as? String,
+        target.hasSuffix(":log") else { return false }
+  let actual = target.dropLast(4).split(separator: ".", omittingEmptySubsequences: false)
+  let expected = shown.split(separator: ".", omittingEmptySubsequences: false)
+  guard actual.count == 5, expected.count == 5, actual[0] == "leve1" else { return false }
+  return [0, 1, 2, 4].allSatisfy { actual[$0] == expected[$0] }
+}
diff --git a/ios/Widgets/LeveLiveActivityRest.swift b/ios/Widgets/LeveLiveActivityRest.swift
new file mode 100644
index 0000000..05cfe8f
--- /dev/null
+++ b/ios/Widgets/LeveLiveActivityRest.swift
@@ -0,0 +1,106 @@
+import ActivityKit
+import Foundation
+import UserNotifications
+
+// Only the current timer's override lives here. Its opaque key changes on each in-app edit.
+final class LeveRestOverride: @unchecked Sendable {
+  static let shared = LeveRestOverride()
+  private let lock = NSLock()
+  private var latest: LeveRestChange?
+
+  func store(_ change: LeveRestChange) {
+    lock.lock()
+    defer { lock.unlock() }
+    latest = change
+  }
+
+  func change(for key: String) -> LeveRestChange? {
+    lock.lock()
+    defer { lock.unlock() }
+    return latest?.key == key ? latest : nil
+  }
+}
+
+actor LeveLiveActivityRest {
+  static let shared = LeveLiveActivityRest()
+  private var tail: Task<Void, Never>?
+
+  // ActivityKit updates suspend. Order button presses and React publications across that await.
+  private func run(_ operation: @escaping @Sendable () async -> Void) async {
+    let previous = tail
+    let next = Task {
+      await previous?.value
+      await operation()
+    }
+    tail = next
+    await next.value
+  }
+
+  private static func decode(_ props: String?) -> [String: Any]? {
+    guard let data = props?.data(using: .utf8) else { return nil }
+    return (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
+  }
+
+  private static func encode(_ props: [String: Any]) -> String? {
+    guard let data = try? JSONSerialization.data(withJSONObject: props) else { return nil }
+    return String(data: data, encoding: .utf8)
+  }
+
+  func interact(source: String, target: String, action: LeveRestAction) async {
+    await run {
+      guard let activity = Activity<LiveActivityAttributes>.activities.first(where: { $0.id == source }),
+            activity.activityState == .active,
+            activity.content.state.name == "LeveWorkout",
+            var props = Self.decode(activity.content.state.props) else { return }
+      if let key = props["restKey"] as? String {
+        LeveRestOverride.shared.change(for: key)?.apply(to: &props)
+      }
+      guard let change = action.change(target: target, props: props, now: Date().timeIntervalSince1970 * 1000)
+        else { return }
+      change.apply(to: &props)
+      guard let encoded = Self.encode(props) else { return }
+      LeveRestOverride.shared.store(change)
+      await LeveRestAlert.follow(change)
+      let state = LiveActivityAttributes.ContentState(name: "LeveWorkout", props: encoded)
+      await activity.update(ActivityContent(state: state, staleDate: change.staleDate))
+      WidgetsEvents.shared.sendNotification(type: .userEvent, data: [
+        "source": source, "target": "LeveRestChanged", "timestamp": Int(Date().timeIntervalSince1970 * 1000)
+      ])
+    }
+  }
+
+  func update(activity: Activity<LiveActivityAttributes>, props: String?, staleDate: Date?) async {
+    await run {
+      var encoded = props
+      var stale = staleDate
+      if var values = Self.decode(props), let key = values["restKey"] as? String,
+         let change = LeveRestOverride.shared.change(for: key) {
+        change.apply(to: &values)
+        if let merged = Self.encode(values) {
+          encoded = merged
+          stale = change.staleDate
+        }
+      }
+      let state = LiveActivityAttributes.ContentState(name: "LeveWorkout", props: encoded)
+      await activity.update(ActivityContent(state: state, staleDate: stale))
+    }
+  }
+}
+
+// Leve's rest-end alert (apps/mobile/modules/leve-rest-alert) follows a rest changed here, since
+// Leve's JavaScript may not run again before iOS suspends it. Only an alert that is already
+// pending moves, so nothing is scheduled while the person has the alert turned off.
+enum LeveRestAlert {
+  static let id = "leve.rest"
+
+  static func follow(_ change: LeveRestChange) async {
+    let center = UNUserNotificationCenter.current()
+    let pending = await center.pendingNotificationRequests()
+    guard let alert = pending.first(where: { $0.identifier == id }) else { return }
+    center.removePendingNotificationRequests(withIdentifiers: [id])
+    let seconds = change.end / 1000 - Date().timeIntervalSince1970
+    guard change.end > 0, seconds > 0 else { return }
+    let trigger = UNTimeIntervalNotificationTrigger(timeInterval: max(1, seconds), repeats: false)
+    try? await center.add(UNNotificationRequest(identifier: id, content: alert.content, trigger: trigger))
+  }
+}
