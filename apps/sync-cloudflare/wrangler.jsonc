{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leve-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountObject" },
      { "name": "RESTORES", "class_name": "RestoreMarker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountObject"] },
    { "tag": "v2", "new_sqlite_classes": ["RestoreMarker"] }
  ]
}
