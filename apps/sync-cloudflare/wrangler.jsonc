{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two Workers. The top level is development (`leve-sync`): Clerk's development instance, used by
  // Leve Dev and TestFlight preview builds, deployed from every main commit whose check passed.
  // `production` (`leve-sync-prod`) uses Clerk's production instance and serves App Store builds;
  // it deploys from release tags' store builds. Each Worker keeps its own secrets and accounts.
  "name": "leve-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountObject" },
      { "name": "RESTORES", "class_name": "RestoreMarker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountObject"] },
    { "tag": "v2", "new_sqlite_classes": ["RestoreMarker"] }
  ],
  "env": {
    "production": {
      "name": "leve-sync-prod",
      // App Store builds and MCP clients reach production here (MCP_RESOURCE_URL is
      // https://sync.leve.timweb.app/mcp). The development Worker has no custom domain.
      "routes": [{ "pattern": "sync.leve.timweb.app", "custom_domain": true }],
      // Only there: the phone's data is tied to the exact server URL, so no second address.
      "workers_dev": false,
      // Bindings aren't inherited by an environment, so they are repeated here
      // (src/wrangler-config.test.ts checks that they match).
      "durable_objects": {
        "bindings": [
          { "name": "ACCOUNTS", "class_name": "AccountObject" },
          { "name": "RESTORES", "class_name": "RestoreMarker" }
        ]
      }
    }
  }
}
