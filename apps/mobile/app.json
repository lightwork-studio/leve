{
  "expo": {
    "name": "Leve Preview",
    "slug": "leve-preview",
    "scheme": "leve-preview",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon-preview.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.leve.preview",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.leve.preview",
      "adaptiveIcon": {
        "backgroundColor": "#101217",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      ["expo-secure-store", { "faceIDPermission": false }],
      ["expo-widgets", { "widgets": [] }]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "webertim",
    "updates": {
      "url": "https://u.expo.dev/eea9c5ba-854f-4bab-af88-72a38fb8d5e2"
    },
    "extra": {
      "eas": {
        "projectId": "eea9c5ba-854f-4bab-af88-72a38fb8d5e2"
      }
    }
  }
}
