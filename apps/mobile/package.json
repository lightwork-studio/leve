{
  "name": "@leve/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "export:demo": "EXPO_NO_DOTENV=1 LEVE_APP_VARIANT=development EXPO_PUBLIC_WEB_DEMO=1 expo export --platform web --output-dir dist/demo",
    "serve:web": "node scripts/serve-web.mts",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "check:ios-bundle": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@clerk/expo": "4.17.5",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.29",
    "@leve/contract": "workspace:*",
    "@leve/core": "workspace:*",
    "@leve/storage": "workspace:*",
    "expo": "~58.0.24",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-widgets": "~58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "sql.js": "~1.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@types/sql.js": "~1.4.11",
    "happy-dom": "^21.0.4",
    "react-test-renderer": "19.3.0",
    "yoga-layout": "3.2.1"
  }
}
